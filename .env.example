# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ── WhatsApp ──────────────────────────────────────────
# mock = log + write to mock_outbox (no real sends)
# live = call Meta Cloud API
WHATSAPP_MODE=mock

# Only required when WHATSAPP_MODE=live
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string

# ── App secrets ───────────────────────────────────────
# 32-byte hex (openssl rand -hex 32) — used for phone hashing
PHONE_HASH_SECRET=
# 32-byte hex — used for encrypting WhatsApp access tokens at rest
TOKEN_ENCRYPTION_KEY=

# ── App config ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
